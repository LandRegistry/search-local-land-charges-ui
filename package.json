    "govuk-frontend": "5.4.0",
    "@turf/union": "^7.0.0",
    "accessible-autocomplete": "^3.0.0",
    "jquery": "^3.7.1",
    "npm-check-updates": "^16.14.20",
    "ol": "^9.2.4",
